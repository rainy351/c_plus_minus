// Standard Library of C± (std.xd)
manual string C_PLUS_MINUS_VERSION = "0.1";

func print(msg) {
    __builtin_sys_print(msg);
}

func println(msg) {
    __builtin_sys_print(msg);
    __builtin_sys_print("\n");
}

