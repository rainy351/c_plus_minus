// Standard Library of C± (std.xd)
manual string C_PLUS_MINUS_VERSION = "0.2";

func print(manual int msg): int {
    __builtin_sys_print(msg);
}

func println(manual int msg): int {
    __builtin_sys_print(msg);
    __builtin_sys_print("\n");
}

func print(manual string msg): int {
    __builtin_sys_print(msg);
}

func println(manual string msg): int {
    __builtin_sys_print(msg);
    __builtin_sys_print("\n");
}

func read_int(): int {
    return __builtin_sys_read_int();
}

func read_str(): string {
    return __builtin_sys_read_str();
}

func time(): int {
    return __builtin_sys_time();
}

func random(): int {
    return __builtin_sys_rand();
}
